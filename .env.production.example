# Archivo de ejemplo para variables de entorno
# Copiar a .env.production y configurar valores reales

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=production
ANGULAR_ENV=production
PORT=3000

# ============================================
# BASE DE DATOS
# ============================================

# MongoDB
DATABASE_URL=mongodb://admin:password123@mongodb:27017/hotel_sebastian?authSource=admin
MONGODB_PASSWORD=password123
MONGODB_USER=admin

# MySQL (alternativa)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=hotel_sebastian

# ============================================
# SEGURIDAD
# ============================================

# JWT
JWT_SECRET=your-very-long-secret-key-change-this-in-production-12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=refresh-secret-key-change-this-12345
JWT_REFRESH_EXPIRE=30d

# CORS
CORS_ORIGIN=https://hotelsebastion.com
CORS_CREDENTIALS=true

# Sesión
SESSION_SECRET=session-secret-key-change-this
SESSION_TIMEOUT=3600000

# ============================================
# API EXTERNA
# ============================================

# Stripe (si usa Stripe para pagos)
STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx

# PayPal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx

# SendGrid (para emails)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@hotelsebastion.com

# ============================================
# CONFIGURACIÓN INFRAESTRUCTURA
# ============================================

# Docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=hotel-sebastian
DOCKER_IMAGE_TAG=latest

# S3 / Cloud Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=hotel-sebastian-uploads

# ============================================
# LOGGING & MONITORING
# ============================================

# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# DataDog (monitoring)
DATADOG_API_KEY=xxxxx
DATADOG_APP_KEY=xxxxx

# ============================================
# FEATURES
# ============================================

ENABLE_ANALYTICS=true
ENABLE_CHATBOT=true
ENABLE_PAYMENT_METHODS=tarjeta,transferencia,paypal
ENABLE_OFFLINE_MODE=false

# ============================================
# CONFIGURACION PRODUCCION
# ============================================

# Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# URLS FRONTEND
# ============================================

FRONTEND_URL=https://hotelsebastion.com
API_URL=https://api.hotelsebastion.com/api
SOCKET_URL=wss://api.hotelsebastion.com/ws

# ============================================
# EMAILS
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Hotel Sebastian <noreply@hotelsebastion.com>

# ============================================
# VERSIONING
# ============================================

APP_VERSION=1.0.0
BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
GIT_COMMIT=$(git rev-parse --short HEAD)
GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
