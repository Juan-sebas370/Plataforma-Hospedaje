# Variables de entorno de producción reales para este proyecto.
# Cada servicio (backend, frontend) se despliega por separado en la
# plataforma administrada (Railway/Render/Fly/etc.); configura estas
# variables ahí, no en un archivo .env commiteado.

# ============================================
# BACKEND (Spring Boot)
# ============================================

# Puerto: la plataforma lo inyecta automáticamente (PORT). No hace falta
# configurarlo a mano.

# Base de datos MySQL
# Dirección JDBC de MySQL que entrega la plataforma (obligatoria en la nube)
DB_URL=jdbc:mysql://tu-servidor-mysql:3306/hotel_sebastian?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=hotel_user
DB_PASSWORD=replace-with-a-real-database-password

# JWT — obligatorio, la app no arranca sin esto
JWT_SECRET=replace-with-at-least-64-random-characters

# Email (Gmail SMTP) para recuperación de contraseña
MAIL_USERNAME=replace-with-mailbox
MAIL_PASSWORD=replace-with-mail-app-password

# Dirección pública de la web, para los enlaces de los correos (recuperar contraseña)
FRONTEND_URL=https://tu-dominio-frontend.com

# Orígenes permitidos por CORS (dominio real del frontend), separados por coma
CORS_ALLOWED_ORIGINS=https://tu-dominio-frontend.com

# Wompi (pasarela de pagos) — llaves de PRODUCCIÓN (pub_prod_/prv_prod_) del
# dashboard: https://comercios.wompi.co/. En el mismo dashboard registrás la
# URL del webhook: https://tu-backend/api/webhooks/wompi
WOMPI_PUBLIC_KEY=replace-with-wompi-public-key
WOMPI_INTEGRITY_SECRET=replace-with-wompi-integrity-secret
WOMPI_EVENTS_SECRET=replace-with-wompi-events-secret

# ============================================
# FRONTEND (Angular SSR)
# ============================================

# apiUrl real del backend desplegado — se configura en
# frontend/src/environments/environment.production.ts, no por variable de
# entorno (Angular resuelve esto en tiempo de build).
