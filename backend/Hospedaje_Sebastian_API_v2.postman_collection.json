                  "console.log('🎉 Reserva creada con código:', pm.response.json().codigoConfirmacion);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Calcular fechas para la reserva",
                  "const hoy = new Date();",
                  "const ingreso = new Date(hoy);",
                  "ingreso.setDate(hoy.getDate() + 7); // 7 días desde hoy",
                  "",
                  "const salida = new Date(ingreso);",
                  "salida.setDate(ingreso.getDate() + 3); // Estancia de 3 días",
                  "",
                  "pm.environment.set('fechaIngreso', ingreso.toISOString().split('T')[0]);",
                  "pm.environment.set('fechaSalida', salida.toISOString().split('T')[0]);",
                  "",
                  "console.log('📅 Fechas calculadas:');",
                  "console.log('  Ingreso:', pm.environment.get('fechaIngreso'));",
                  "console.log('  Salida:', pm.environment.get('fechaSalida'));"
                ]
              }
            }
          ],
