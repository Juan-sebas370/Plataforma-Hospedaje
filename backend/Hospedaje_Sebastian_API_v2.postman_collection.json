      "description": "Endpoints de registro, login y recuperación de contraseña",
      "item": [
        {
          "name": "📝 Registro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test('✅ Usuario registrado correctamente', function () {",
                  "        const response = pm.response.json();",
                  "        pm.expect(response).to.have.property('token');",
                  "        pm.expect(response).to.have.property('user');",
                  "    });",
                  "    ",
                  "    pm.test('💾 Token guardado en variable', function () {",
                  "        const response = pm.response.json();",
                  "        pm.environment.set('authToken', response.token);",
                  "        pm.environment.set('userId', response.user.id);",
                  "        pm.expect(pm.environment.get('authToken')).to.not.be.undefined;",
                  "    });",
                  "    ",
                  "    console.log('🎉 Usuario registrado:', pm.response.json().user.email);",
