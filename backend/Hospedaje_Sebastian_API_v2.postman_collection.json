                  "    pm.environment.set('reservaId', response.id);",
                  "    pm.environment.set('codigoConfirmacion', response.codigoConfirmacion);",
                  "    pm.expect(pm.environment.get('reservaId')).to.not.be.undefined;",
                  "});",
