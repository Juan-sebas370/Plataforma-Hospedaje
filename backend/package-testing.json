{
  "name": "hospedaje-sebastian-api",
  "version": "2.0.0",
  "description": "API REST para sistema de gestión hotelera - Hospedaje Sebastian",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/**/*.test.js",
    "test:watch": "nodemon --exec 'npm run test'",
    "test:postman": "newman run './Hospedaje_Sebastian_API_v2.postman_collection.json' -e './Hospedaje_Sebastian_Environment.postman_environment.json'",
    "test:postman:local": "npm run test:postman",
    "test:postman:staging": "newman run './Hospedaje_Sebastian_API_v2.postman_collection.json' -e './Hospedaje_Sebastian_Staging.postman_environment.json'",
    "test:postman:all": "npm run test:postman:local && npm run test:postman:staging",
    "test:postman:report": "node run-tests.js",
    "test:postman:windows": "run-tests.bat",
    "test:postman:unix": "bash run-tests.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "echo 'Build script - para producción'",
    "prestart": "echo '🚀 Iniciando servidor...'",
    "poststart": "echo '✅ Servidor iniciado correctamente'",
    "pretest": "npm run lint",
    "docker:build": "docker build -t hospedaje-sebastian-api:latest .",
    "docker:run": "docker run -p 3000:3000 hospedaje-sebastian-api:latest"
  },
  "keywords": [
    "hotel",
    "reservas",
    "api",
    "rest",
    "nodejs",
    "express"
  ],
  "author": "Hospedaje Sebastian Development Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.1.2",
    "sequelize": "^6.28.0",
    "joi": "^17.7.0",
    "axios": "^1.3.2",
    "stripe": "^11.5.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "newman": "^5.3.2",
    "newman-reporter-htmlextra": "^1.22.11",
    "eslint": "^8.33.0",
    "prettier": "^2.8.3",
    "jest": "^29.4.0",
    "supertest": "^6.3.3"
  },
  "nodemonConfig": {
    "ignore": [
      "test-reports/*",
      "node_modules/*"
    ],
    "delay": 500
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "semi": ["error", "always"]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hospedaje-sebastian/api.git"
  },
  "bugs": {
    "url": "https://github.com/hospedaje-sebastian/api/issues"
  },
  "homepage": "https://hospedaje-sebastian.com"
}
